[node name="GoalLabel" type="RichTextLabel" parent="Tutorialcontainer/TutorialLabelContainer"]
layout_mode = 2
theme_override_colors/default_color = Color(1, 1, 0, 1)
theme_override_font_sizes/normal_font_size = 22
bbcode_enabled = true
text = "[color=#ff0000][font=res://assets/fonts/6_Segoe_Print.ttf]Goal:[/font][/color] Stay alive and do not crash unto others.
Everytime someone else dies, you will get a 
point. The first to reach the goal, will win the
game."
fit_content = true

[node name="ControlLabel" type="RichTextLabel" parent="Tutorialcontainer/TutorialLabelContainer"]
layout_mode = 2
theme_override_colors/default_color = Color(1, 1, 0, 1)
theme_override_font_sizes/normal_font_size = 22
bbcode_enabled = true
text = "[color=#ff0000][font=res://assets/fonts/6_Segoe_Print.ttf]Controls:[/font][/color] Press your left or right key to turn left
or right.
Your curve will make holes, where you and others 
can try to sneak through."
fit_content = true

[node name="Game Mode" type="RichTextLabel" parent="Tutorialcontainer/TutorialLabelContainer"]
layout_mode = 2
theme_override_colors/default_color = Color(1, 1, 0, 1)
theme_override_font_sizes/normal_font_size = 22
bbcode_enabled = true
text = "[color=#ff0000][font=res://assets/fonts/6_Segoe_Print.ttf]Game mode:[/font][/color] You can play either in [color=#00d900]arcade[/color] 
mode, or in [color=#00d900]classic[/color] mode. The only difference is 
that in classic mode there are no powerups, and 
in arcade mode, there are."
fit_content = true

[node name="Powerups" type="RichTextLabel" parent="Tutorialcontainer/TutorialLabelContainer"]
layout_mode = 2
theme_override_colors/default_color = Color(1, 1, 0, 1)
theme_override_font_sizes/normal_font_size = 22
bbcode_enabled = true
text = "[color=#ff0000][font=res://assets/fonts/6_Segoe_Print.ttf]Powerups:[/font][/color] All the powerups are listed below. They can help you in 
you struggle.
You can chose the powerups to play with by the Configure PowerUps 
button in the menu and get precsie description of their effect."
fit_content = true

